# Docker Compose 部署环境变量示例（阶段 11.4）
#
# 用法：复制为 .env 并填入真实值
#   cp .env.docker.example .env
#   # 编辑 .env 填入 LLM_API_KEY 等
#   docker compose up -d
#
# docker compose 自动读取同目录 .env 文件，注入 docker-compose.yml 中的 ${VAR}。
# 安全约束：.env 已在 .gitignore 中，禁止提交真实密钥；API key 严禁硬编码。

# ---------------------------------------------------------------------------
# PostgreSQL（docker-compose 内置服务，密码建议改为强随机值）
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=rrag

# ---------------------------------------------------------------------------
# 大模型（必须配置，否则问答功能不可用）
# OpenAI 兼容协议：DeepSeek / Moonshot / Together / 本地 vLLM 等
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embedding 模型（容器默认 local 本地推理，镜像已含 sentence-transformers）
# 默认 BAAI/bge-small-zh-v1.5（中文小模型，512 维，中文场景最优）
# 可选：BAAI/bge-small-en-v1.5（英文）、BAAI/bge-m3（多语言，约 2.2GB）
# 注：首次启动需下载模型（bge-small 约 100MB），之后缓存到镜像层
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_PROVIDER=local

# ---------------------------------------------------------------------------
# Reranker / BM25（默认关闭，按需开启）
# RERANKER_ENABLED=true 启用 Cross-Encoder 重排序（镜像已含依赖）
# BM25_ENABLED=true 启用 BM25 混合检索（中文需 BM25_USE_JIEBA=true）
# ---------------------------------------------------------------------------
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base
BM25_ENABLED=false
BM25_USE_JIEBA=true

# ---------------------------------------------------------------------------
# 文件上传与切分
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8
QDRANT_COLLECTION=research_chunks

# ---------------------------------------------------------------------------
# Langfuse 可观测性（可选，三项非空才启用，未配置 no-op）
# 部署 Langfuse 服务见 docker-compose.langfuse.yml
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
