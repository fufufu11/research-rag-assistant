# Docker Secrets 宿主机文件路径配置示例（阶段 11.6 切片 D #101）
#
# 用法：复制为 .env.docker.secrets 并填入真实宿主机路径
#   cp .env.docker.secrets.example .env.docker.secrets
#   # 编辑 .env.docker.secrets 填入 8 个 secrets 文件的宿主机绝对路径
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.docker.secrets up -d
#
# 工作原理：
#   docker-compose.prod.yml 的顶级 secrets: 块用 ${VAR_FILE} 引用本文件中的路径，
#   docker compose 把宿主机文件挂载到容器内 /run/secrets/<secret_name>，
#   应用层 get_secret helper（src/research_rag/secrets.py）读取 {NAME}_FILE 环境变量
#   指向的文件内容作为密钥值。secrets 不进进程环境变量（docker inspect 不可见）。
#
# 安全约束：
#   - .env.docker.secrets 已在 .gitignore 中，禁止提交
#   - 真实 secrets 文件由运维创建，权限 chmod 600（仅 owner 可读写）
#   - 文件内容为纯文本密钥值（无 key= 前缀，无引号，可含尾部换行会被 strip）
#   - API key 严禁硬编码或入 git

# ---------------------------------------------------------------------------
# 8 个 secrets 文件的宿主机绝对路径
# 路径示例：/etc/rrag/secrets/<name>.txt（运维自定义，下同）
# ---------------------------------------------------------------------------

# PostgreSQL 数据库密码（postgres 容器用 POSTGRES_PASSWORD_FILE 读取）
POSTGRES_PASSWORD_FILE=/etc/rrag/secrets/postgres_password.txt

# 大模型 API Key（OpenAI 兼容协议：DeepSeek / Moonshot / Together / 本地 vLLM 等）
LLM_API_KEY_FILE=/etc/rrag/secrets/llm_api_key.txt

# 评测 Judge LLM API Key（未配置时 fallback 到 LLM_API_KEY）
JUDGE_LLM_API_KEY_FILE=/etc/rrag/secrets/judge_llm_api_key.txt

# API 网关鉴权 Key（多个用逗号分隔，如 key1,key2）
API_KEYS_FILE=/etc/rrag/secrets/api_keys.txt

# Langfuse 可观测性（可选，三项非空才启用）
LANGFUSE_PUBLIC_KEY_FILE=/etc/rrag/secrets/langfuse_public_key.txt
LANGFUSE_SECRET_KEY_FILE=/etc/rrag/secrets/langfuse_secret_key.txt

# DashScope API Key（阿里通义千问 Embedding / Reranker 用）
DASHSCOPE_API_KEY_FILE=/etc/rrag/secrets/dashscope_api_key.txt

# Jina API Key（Jina Embedding / Reranker 用）
JINA_API_KEY_FILE=/etc/rrag/secrets/jina_api_key.txt
