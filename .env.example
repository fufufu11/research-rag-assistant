# 科研文献可溯源智能问答系统 - 环境变量示例
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，禁止提交真实密钥。
# 配置项说明见 docs/architecture.md 第 6 节

# ---------------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Streamlit UI 调用 FastAPI API 的基地址（阶段 6 启用）
# 默认 http://localhost:8000/api/v1，部署时改为实际 API 地址
API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# 元数据数据库（阶段 5 已启用 SQLAlchemy + Alembic）
# 本地默认 SQLite；生产可改为 PostgreSQL：postgresql+psycopg://user:pass@host/db
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------------------
# 向量数据库（阶段 3 用 LangChain InMemoryVectorStore，阶段 6 迁移到 Qdrant）
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks
# 设为 false 可显式禁用 Qdrant（测试或无 Docker 环境时，service 层回退到 InMemoryVectorStore）
QDRANT_ENABLED=true

# ---------------------------------------------------------------------------
# 大模型（阶段 4 启用；OpenAI 兼容协议 API 调用）
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 单次请求超时秒数（保守默认 30，避免长时间挂起）
LLM_TIMEOUT=30
# 失败重试次数（保守默认 2，由 httpx 实现指数退避）
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embedding 模型（阶段 3 启用，阶段 8.4 修复 EMBEDDING_MODEL 环境变量读取 + 集成 bge-m3 可选）
# 默认 BAAI/bge-small-zh-v1.5（中文小模型，512 维，体积小、推理快，中文场景最优）
# 可选切换：
#   - BAAI/bge-small-en-v1.5：英文专用小模型，评测英文论文时推荐
#   - BAAI/bge-m3：BAAI 多语言模型，dense 1024 维，原生支持中英文混合检索，
#     统一覆盖中英双模型场景；体积约 2.2GB，推理慢于 bge-small
#     注：阶段 8.4 实测 bge-m3 在纯英文论文评测下不及 bge-small-en（Hit@5
#     70% vs 76.7%），故默认仍保留小模型，bge-m3 作为多语言场景的可选项。
# 切换模型后维度变化（512→1024），Qdrant 集合需删除重建：删除已上传文档后重新上传，
#   或清空 QDRANT_COLLECTION 集合。InMemoryVectorStore 无此问题（每次启动重建）。
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------------------------------------------------------------------------
# Reranker 重排序（阶段 8 启用；可选，默认关闭）
# RERANKER_ENABLED=true 时启用 Cross-Encoder 对向量检索 Top-K 结果重排序
# 需运行 `uv sync --extra embedding` 安装 sentence-transformers
# ---------------------------------------------------------------------------
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------------------------------------------------------------------
# BM25 混合检索（阶段 8.3 启用；可选，默认关闭）
# BM25_ENABLED=true 时启用 BM25 + 向量并行召回 + RRF 融合（Hybrid Retrieval）
# 对关键词列表、数值、公式类问题（向量检索弱项）有改善
# 中文场景需运行 `uv sync --extra chinese` 安装 jieba 分词；英文场景无需此 extra
# ---------------------------------------------------------------------------
BM25_ENABLED=false
BM25_K1=1.5
BM25_B=0.75
BM25_USE_JIEBA=true

# ---------------------------------------------------------------------------
# 文件上传与切分参数（阶段 1-2 启用）
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8
