# 科研文献可溯源智能问答系统 - 环境变量示例
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，禁止提交真实密钥。
# 配置项说明见 docs/architecture.md 第 6 节

# ---------------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# Streamlit UI 调用 FastAPI API 的基地址（阶段 6 启用）
# 默认 http://localhost:8000/api/v1，部署时改为实际 API 地址
API_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# 元数据数据库（阶段 5 已启用 SQLAlchemy + Alembic）
# 本地默认 SQLite；生产可改为 PostgreSQL：postgresql+psycopg://user:pass@host/db
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------------------
# 向量数据库（阶段 3 用 LangChain InMemoryVectorStore，阶段 6 迁移到 Qdrant）
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks
# 设为 false 可显式禁用 Qdrant（测试或无 Docker 环境时，service 层回退到 InMemoryVectorStore）
QDRANT_ENABLED=true

# ---------------------------------------------------------------------------
# 大模型（阶段 4 启用；OpenAI 兼容协议 API 调用）
# ---------------------------------------------------------------------------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 单次请求超时秒数（保守默认 30，避免长时间挂起）
LLM_TIMEOUT=30
# 失败重试次数（保守默认 2，由 httpx 实现指数退避）
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embedding 模型（阶段 3 启用，阶段 8.4 修复 EMBEDDING_MODEL 环境变量读取 + 集成 bge-m3 可选）
# 默认 BAAI/bge-small-zh-v1.5（中文小模型，512 维，体积小、推理快，中文场景最优）
# 可选切换：
#   - BAAI/bge-small-en-v1.5：英文专用小模型，评测英文论文时推荐
#   - BAAI/bge-m3：BAAI 多语言模型，dense 1024 维，原生支持中英文混合检索，
#     统一覆盖中英双模型场景；体积约 2.2GB，推理慢于 bge-small
#     注：阶段 8.4 实测 bge-m3 在纯英文论文评测下不及 bge-small-en（Hit@5
#     70% vs 76.7%），故默认仍保留小模型，bge-m3 作为多语言场景的可选项。
# 切换模型后维度变化（512→1024），Qdrant 集合需删除重建：删除已上传文档后重新上传，
#   或清空 QDRANT_COLLECTION 集合。InMemoryVectorStore 无此问题（每次启动重建）。
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Embedding 提供方（阶段 8.4）：local（默认，本地 HuggingFace 推理）、dashscope
# （阿里百炼 OpenAI 兼容 API）或 jina（Jina AI OpenAI 兼容 API）。API 模式适合
# 本地 CPU 推理慢（如 bge-m3 约 2.2GB）或需更大模型但不想本地部署的场景。
# 设为 dashscope 时 EMBEDDING_MODEL 默认 text-embedding-v4（Qwen3-Embedding，1024 维），
#   需设置 DASHSCOPE_API_KEY。
# 设为 jina 时 EMBEDDING_MODEL 默认 jina-embeddings-v3（多语言含中文，1024 维），
#   需设置 JINA_API_KEY（Jina AI 提供免费额度：500 RPM + 200 万 TPM）。
EMBEDDING_PROVIDER=local

# 阿里百炼（DashScope）API Key（EMBEDDING_PROVIDER=dashscope 时必填）
# 安全约束：绝不硬编码到代码、不提交到 git、不写入文档/报告。
# .env 不会被 FastAPI 自动加载，需显式设置环境变量：
#   PowerShell: $env:DASHSCOPE_API_KEY="sk-..."
#   bash:       export DASHSCOPE_API_KEY="sk-..."
DASHSCOPE_API_KEY=

# Jina AI API Key（EMBEDDING_PROVIDER=jina 时必填）
# 注册地址 https://jina.ai ，新用户有免费额度。
# 安全约束：绝不硬编码到代码、不提交到 git、不写入文档/报告。
#   PowerShell: $env:JINA_API_KEY="jina_..."
#   bash:       export JINA_API_KEY="jina_..."
JINA_API_KEY=

# 可选：API endpoint（dashscope 默认百炼 endpoint，jina 默认 https://api.jina.ai/v1）
# EMBEDDING_BASE_URL=

# 可选：向量维度（默认 1024；text-embedding-v4 / jina-embeddings-v3 均支持降维）
# EMBEDDING_DIMENSIONS=1024

# 可选：单次请求行数上限（默认 10，受 API 单次请求行数限制，超限返回 400）
# EMBEDDING_BATCH_SIZE=10

# ---------------------------------------------------------------------------
# Reranker 重排序（阶段 8 启用；可选，默认关闭）
# RERANKER_ENABLED=true 时启用 Cross-Encoder 对向量检索 Top-K 结果重排序
# 需运行 `uv sync --extra embedding` 安装 sentence-transformers
# ---------------------------------------------------------------------------
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------------------------------------------------------------------
# BM25 混合检索（阶段 8.3 启用；可选，默认关闭）
# BM25_ENABLED=true 时启用 BM25 + 向量并行召回 + RRF 融合（Hybrid Retrieval）
# 对关键词列表、数值、公式类问题（向量检索弱项）有改善
# 中文场景需运行 `uv sync --extra chinese` 安装 jieba 分词；英文场景无需此 extra
# ---------------------------------------------------------------------------
BM25_ENABLED=false
BM25_K1=1.5
BM25_B=0.75
BM25_USE_JIEBA=true

# ---------------------------------------------------------------------------
# 文件上传与切分参数（阶段 1-2 启用；阶段 11.2 接入输入校验）
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
# 上传文件大小上限（兆字节）。阶段 11.2 起由路由层强制校验，超过返回 413。
MAX_UPLOAD_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8

# ---------------------------------------------------------------------------
# 输入校验（阶段 11.2 启用；PDF 白名单 + 大小限制 + Prompt 注入过滤）
# 默认启用（安全功能默认开是最佳实践，仅影响非法请求，不影响合法用户）。
# 设为 false 关闭校验（开发/调试场景）；生产环境务必保持 true。
# 启用后：
#   - 上传非 PDF 文件返回 415（扩展名 + content_type 双重白名单）
#   - 上传超过 MAX_UPLOAD_MB 的文件返回 413
#   - 问答 question 含注入模式（ignore previous / system: 等）返回 400
# ---------------------------------------------------------------------------
INPUT_VALIDATION_ENABLED=true

# ---------------------------------------------------------------------------
# 可观测性（阶段 10.1 启用；Langfuse 自部署全链路追踪）
# 三项环境变量必须全部非空才启用，任一缺失即 no-op（不影响应用行为）。
# 本地开发、CI、测试环境无需配置；生产环境显式设置后启用 trace 上报。
# 部署 Langfuse 服务见 docker-compose.langfuse.yml
# 安全约束：绝不硬编码到代码、不提交到 git、不写入文档/报告。
#   PowerShell: $env:LANGFUSE_PUBLIC_KEY="pk-lf-..."
#               $env:LANGFUSE_SECRET_KEY="sk-lf-..."
#               $env:LANGFUSE_HOST="http://localhost:3000"
#   bash:       export LANGFUSE_PUBLIC_KEY="pk-lf-..."
#               export LANGFUSE_SECRET_KEY="sk-lf-..."
#               export LANGFUSE_HOST="http://localhost:3000"
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# ---------------------------------------------------------------------------
# 认证鉴权（阶段 11.1 启用；API Key 认证，防止未授权访问）
# 默认禁用（开发友好，向后兼容）；生产环境设 API_KEY_ENABLED=true 启用。
# 启用后，所有 /api/v1/* 端点需在请求头携带 Authorization: Bearer <key>。
# 安全约束：绝不硬编码到代码、不提交到 git、不写入文档/报告。
#   PowerShell: $env:API_KEY_ENABLED="true"
#               $env:API_KEYS="your-secret-key-1,your-secret-key-2"
#   bash:       export API_KEY_ENABLED=true
#               export API_KEYS="your-secret-key-1,your-secret-key-2"
# ---------------------------------------------------------------------------
# 设为 true 启用认证（默认禁用）。未设或非 true 时所有端点可匿名访问。
API_KEY_ENABLED=false

# 有效 API Key 列表（逗号分隔，支持多个，便于按客户端隔离与轮换）。
# 启用认证后，请求头携带 Authorization: Bearer <任一key> 即可通过。
# 为空时启用认证会安全失败（所有请求 401），避免认证形同虚设。
API_KEYS=

# Streamlit UI 调用 API 时携带的 API Key（UI 端配置，对应 API_KEYS 中的某个 key）。
# API 端启用认证后，UI 必须设置此项才能调用；未设置时不携带 Authorization 头
# （兼容 API 端禁用认证的开发场景）。
API_KEY=
