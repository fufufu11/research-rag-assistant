# 科研文献可溯源智能问答系统 - 环境变量示例
# 复制为 .env 并填入真实值；.env 已在 .gitignore 中，禁止提交真实密钥。
# 配置项来源：PROJECT_PLAN.md 第 11 节

# ---------------------------------------------------------------------------
# 应用基础
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# 元数据数据库（阶段 5 已启用 SQLAlchemy + Alembic）
# 本地默认 SQLite；生产可改为 PostgreSQL：postgresql+psycopg://user:pass@host/db
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/app.db

# ---------------------------------------------------------------------------
# 向量数据库（阶段 3 用 LangChain InMemoryVectorStore，阶段 6 迁移到 Qdrant）
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=research_chunks
# 设为 false 可显式禁用 Qdrant（测试或无 Docker 环境时，service 层回退到 InMemoryVectorStore）
QDRANT_ENABLED=true

# ---------------------------------------------------------------------------
# 大模型（阶段 4 启用；支持 OpenAI 兼容协议 API 调用 或 本地 Ollama 离线推理）
# ---------------------------------------------------------------------------
# LLM 提供方：
#   openai（默认）：用 API 调用 OpenAI 兼容服务（DeepSeek/智谱/OpenAI 等），需下方 LLM_API_KEY
#   ollama：用本地 Ollama 服务，免费离线，无需 API Key（安装见 https://ollama.com/download）
LLM_PROVIDER=openai

# ---- OpenAI 兼容协议配置（LLM_PROVIDER=openai 时生效）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 本地 Ollama 配置（LLM_PROVIDER=ollama 时生效）----
# 拉取模型：ollama pull qwen2.5:3b-instruct（约 2GB，中文友好，适合测试）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# ---- 共享参数（两个 provider 都生效）----
# 单次请求超时秒数（保守默认 30，避免长时间挂起）
LLM_TIMEOUT=30
# 失败重试次数（保守默认 2，由 httpx 实现指数退避；仅 OpenAI provider 生效，Ollama 自行管理重试）
LLM_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Embedding 模型（阶段 3 启用）
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ---------------------------------------------------------------------------
# 文件上传与切分参数（阶段 1-2 启用）
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVAL_TOP_K=8
